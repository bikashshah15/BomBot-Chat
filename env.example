# 🤖 BOMbot Environment Configuration
# Copy this file to .env and fill in your values

# ========================================
# Required Environment Variables
# ========================================

# OpenAI API Configuration (Required)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-server-secret-key

# ========================================
# Optional Environment Variables  
# ========================================

# OSV Scanner Path (Local Development Only)
# Leave empty to use npm osv-scanner package
# OSV_SCANNER_PATH=/opt/homebrew/bin/osv-scanner

# Development Configuration
# NODE_ENV=development

# ========================================
# Deployment Configuration (Vercel)
# ========================================

# These are automatically set by Vercel
# VERCEL_URL=your-app.vercel.app
# VERCEL_ENV=production

# ========================================
# How to Get These Values:
# ========================================
# 
# 1. OPENAI_API_KEY:
#    - Go to https://platform.openai.com/api-keys
#    - Click "Create new secret key"
#    - Copy the key (starts with sk-proj-)
#
# 2. OPENAI_MODEL:
#    - Keep gpt-4o for compatibility with the migrated Responses API integration
#    - Change only after separately evaluating a model migration
#
# 3. OSV_SCANNER_PATH (Local Only):
#    - macOS: brew install osv-scanner
#    - Linux: Download from GitHub releases
#    - Leave empty to use npm package version
#
# 4. SUPABASE VARIABLES:
#    - Go to your Supabase project's API settings
#    - Use the project URL and browser-safe anon or publishable key for NEXT_PUBLIC_ variables
#    - Keep SUPABASE_SERVICE_ROLE_KEY server-side only
