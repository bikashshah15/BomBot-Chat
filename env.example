# 🤖 BOMbot Environment Configuration
# Copy this file to .env and fill in your values

# ========================================
# Required Environment Variables
# ========================================

# Local Postgres Configuration (Required)
# Matches the literal local-development credentials in docker-compose.dev.yml
DATABASE_URL=postgresql://bombot:bombot_dev_password@127.0.0.1:5432/bombot

# OpenAI API Configuration (Required)
OPENAI_MODEL=gpt-4o

# Runtime profile: hosted or local
PROFILE=your-runtime-profile
# Base URL for the configured LLM provider
LLM_BASE_URL=https://your-llm-provider.example/v1
# Model identifier required by the validated configuration
LLM_MODEL=your-llm-model
LLM_API_KEY=your-llm-api-key
# OSV access mode: api or offline
OSV_MODE=your-osv-mode
# Data retention mode: study or ephemeral
RETENTION=your-retention-mode
# Participant identifier mode. Defaults to email until Bikash resolves the IRB decision.
PARTICIPANT_ID_MODE=email
# Required only when PARTICIPANT_ID_MODE=pseudonymous; use at least 32 characters.
# PARTICIPANT_ID_SALT=replace-with-a-private-random-salt
# Optional conversation-history bound; defaults to 20 when unset.
MAX_HISTORY_TURNS=20
# Sampling temperature required by the study configuration
LLM_TEMPERATURE=your-temperature
# Top-p sampling value required by the study configuration
LLM_TOP_P=your-top-p
# Maximum generated tokens required by the study configuration
LLM_MAX_OUTPUT_TOKENS=your-max-output-tokens
# Optional numeric seed; use null when unset
LLM_SEED=your-seed-or-null

# ========================================
# Optional Environment Variables  
# ========================================

# OSV Scanner Path (Local Development Only)
# Leave empty to use npm osv-scanner package
# OSV_SCANNER_PATH=/opt/homebrew/bin/osv-scanner

# Development Configuration
# NODE_ENV=development

# ========================================
# Deployment Configuration (Vercel)
# ========================================

# These are automatically set by Vercel
# VERCEL_URL=your-app.vercel.app
# VERCEL_ENV=production

# ========================================
# How to Get These Values:
# ========================================
# 
# 1. OPENAI_MODEL:
#    - Keep gpt-4o for compatibility with the migrated Responses API integration
#    - Change only after separately evaluating a model migration
#
# 2. OSV_SCANNER_PATH (Local Only):
#    - macOS: brew install osv-scanner
#    - Linux: Download from GitHub releases
#    - Leave empty to use npm package version
